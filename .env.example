# This is a template for your environment variables.
# Copy this file to .env and fill in your actual values.

# --- Firebase Configuration ---
FIREBASE_DB_URL="https://your-project-name-default-rtdb.firebaseio.com/"

# --- Twilio Configuration ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_NUMBER="+15017122661" # Your Twilio phone number

# --- Application Secrets ---
ADMIN_PASSWORD="your_admin_dashboard_password"
MODERATOR_SECRET="your_moderator_secret_for_peer_chat"
ESCALATE_SECRET="a_very_secret_string_for_the_webhook"

# --- Counsellor and Webhook URLs ---
COUNSELLOR_NUMBER="+919999999999" # The number to call in an emergency
ESCALATE_WEBHOOK_URL="http://localhost:8000/escalate" # Use your ngrok URL for testing
CALL_EVENTS_URL="http://localhost:5001/call-events" # Optional: ngrok URL for Twilio status callbacks
